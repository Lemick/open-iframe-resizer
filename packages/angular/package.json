{
  "name": "angular",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "serve": "ng serve demo --port 5001",
    "serve:dist": "serve dist/demo/browser -l 5001",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build lib --configuration production",
    "build:demo": "ng build demo --configuration production",
    "lint": "biome lint ./projects",
    "test": "npx playwright install --with-deps && npx playwright test"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@open-iframe-resizer/core": "3.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "injection-js": "^2.6.1",
    "ng-packagr": "^21.0.0",
    "serve": "^14.2.7",
    "typescript": "~5.9.3"
  }
}
